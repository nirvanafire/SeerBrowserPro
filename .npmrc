# 保证 devDependencies 在任何环境（CI / 生产 / 本地）都会被安装
# GitHub Actions Windows runner 默认不应有 NODE_ENV=production，
# 但本项目的 electron-builder / electron-vite / vitest / tsc 全在 devDep，
# 任何漏装 devDep 的场景都会直接导致打包或测试失败。
include=dev
# 双重保险：显式关闭 npm 的 production 模式（某些 CI 环境变量会触发）
production=false
# Electron 二进制下载走国内镜像，GitHub Actions 上 npmmirror 可达性比默认源好
electron_mirror=https://npmmirror.com/mirrors/electron/
